# ==========================================
# EOTC Learning Platform - Environment Configuration
# ==========================================

# Node & Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://your-app.vercel.app

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eotc_learning?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eotc_learning_test?schema=public"

# Authentication & JWT Secrets
JWT_ACCESS_SECRET="dev-super-secret-jwt-access-token-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="dev-super-secret-jwt-refresh-token-key-change-in-production-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudinary Storage (Textbooks & Downloadable References)
CLOUDINARY_CLOUD_NAME="eotc-learning"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_FOLDER="eotc-learning-materials"

# Admin Initial Seed Credentials
INITIAL_ADMIN_EMAIL="admin@eotc-andnet.org"
INITIAL_ADMIN_PASSWORD="AdminSecurePassword2026!"
INITIAL_ADMIN_NAME="ሊቀ ጉባኤ Admin"

# Password reset emails (SMTP). Leave SMTP_HOST empty in development: the reset link is printed in the API console.
WEB_APP_URL=http://localhost:3001
PASSWORD_RESET_EXPIRES_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EOTC Sunday School <no-reply@yourdomain.com>"

# Telegram Mini App (optional; see docs/telegram-mini-app.md). Leave TELEGRAM_BOT_TOKEN empty to disable.
# When the token is set, the other three are required and the API refuses to start without them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# 16-256 characters of A-Z, a-z, 0-9, _ and -; Telegram sends it back on every webhook call
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBAPP_URL=https://your-app.vercel.app/tg
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
