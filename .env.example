# ==========================================
# EOTC Learning Platform - Environment Configuration
# ==========================================

# Node & Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:19006,exp://*

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eotc_learning?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eotc_learning_test?schema=public"

# Authentication & JWT Secrets
JWT_ACCESS_SECRET="dev-super-secret-jwt-access-token-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="dev-super-secret-jwt-refresh-token-key-change-in-production-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudinary Storage (Textbooks & Downloadable References)
CLOUDINARY_CLOUD_NAME="eotc-learning"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_FOLDER="eotc-learning-materials"

# Admin Initial Seed Credentials
INITIAL_ADMIN_EMAIL="admin@eotc-andnet.org"
INITIAL_ADMIN_PASSWORD="AdminSecurePassword2026!"
INITIAL_ADMIN_NAME="ሊቀ ጉባኤ Admin"
