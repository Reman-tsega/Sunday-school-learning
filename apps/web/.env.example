# Public API base used by the browser (must end with /api)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Backend origin used by Next.js rewrites for /api and /uploads (no /api suffix)
API_ORIGIN=http://localhost:4000
# Show the one-click sample logins on /login (pair with SEED_DEMO_ACCOUNTS=true on the API). Never enable in production.
NEXT_PUBLIC_SHOW_DEMO_LOGINS=false
