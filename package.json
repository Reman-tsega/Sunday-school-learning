{
  "name": "eotc-learning-platform",
  "version": "0.1.0",
  "private": true,
  "description": "EOTC Senbet Tmhrtbetoch Andnet Lean Offline-First Learning Platform",
  "scripts": {
    "build": "pnpm --filter \"@eotc/*\" build",
    "lint": "pnpm --filter \"@eotc/*\" lint",
    "typecheck": "pnpm --filter \"@eotc/*\" typecheck",
    "test": "pnpm --filter \"@eotc/api\" --filter \"@eotc/web\" --filter \"@eotc/mobile\" test",
    "db:migrate": "pnpm --filter \"@eotc/api\" db:migrate",
    "db:seed": "pnpm --filter \"@eotc/api\" db:seed",
    "db:studio": "pnpm --filter \"@eotc/api\" db:studio",
    "dev:api": "pnpm --filter \"@eotc/api\" dev",
    "dev:web": "pnpm --filter \"@eotc/web\" dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
